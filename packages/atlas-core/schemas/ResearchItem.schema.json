{
  "$defs": {
    "ItemScores": {
      "properties": {
        "relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance",
          "type": "number"
        },
        "quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "novelty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty",
          "type": "number"
        },
        "recency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Recency",
          "type": "number"
        },
        "social": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Social",
          "type": "number"
        }
      },
      "required": [
        "relevance",
        "quality",
        "novelty",
        "recency",
        "social"
      ],
      "title": "ItemScores",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "paper",
        "post",
        "thesis",
        "news"
      ],
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "canonical_key": {
      "title": "Canonical Key",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "axis": {
      "title": "Axis",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/ItemScores"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "url",
    "canonical_key",
    "axis",
    "scores",
    "rank"
  ],
  "title": "ResearchItem",
  "type": "object"
}
